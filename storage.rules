rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Règles pour les images d'événements
    match /events/{imageId} {
      // Lecture publique
      allow read: if true;
      
      // Écriture uniquement pour les utilisateurs authentifiés
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Règles pour les images de profil
    match /profiles/{userId}/{imageId} {
      // Lecture publique
      allow read: if true;
      
      // Écriture uniquement par le propriétaire
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024  // Max 2MB
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
