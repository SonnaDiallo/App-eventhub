# Configuration Stripe (obligatoire pour les paiements)
STRIPE_SECRET_KEY=sk_test_xxx

# Clé API Ticketmaster (obligatoire pour les événements externes)
TICKETMASTER_API_KEY=votre_cle_ticketmaster_ici

# Configuration Email Gmail (optionnel - pour l'envoi automatique de billets)
# Pour Gmail, utiliser un "mot de passe d'application":
# https://myaccount.google.com/apppasswords
EMAIL_USER=votre-email@gmail.com
EMAIL_PASS=votre-mot-de-passe-app
