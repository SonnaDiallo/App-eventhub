# Base de données : le backend utilise uniquement Firestore (Firebase).
# Plus besoin de MongoDB / MONGO_URI.

# Server Port
PORT=5000

# Firebase Admin SDK (pour l'authentification)
# Le chemin vers le fichier JSON de service account Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=

# JWT Secret (pour les tokens)
JWT_SECRET=your_jwt_secret_here

# Emails admin (séparés par des virgules) : rôle "admin" attribué à l'inscription via l'API.
# Pour un compte déjà créé via l'app mobile, mettre role: "admin" dans Firestore (users/<uid>).
ADMIN_EMAILS=

# API Keys - Événements externes (Ticketmaster uniquement)
# Pour obtenir une clé: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=
# Pour obtenir une clé Unsplash (optionnel, pour les images): https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
